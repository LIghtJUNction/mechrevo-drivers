+bool cthd_sensor_virtual::_read_temperature_checked(unsigned int &out) {
+    std::lock_guard<std::mutex> guard(sample_mutex);
+    last_temp_valid = false;
+    if (link_sensors.empty()) return false;
+    const bool linear = link_sensors[0]->sensor && !link_sensors[0]->coeff && !link_sensors[0]->offset;
+    std::vector<unsigned int> readings;
+    const unsigned int input_count = linear ? 1 : link_sensors.size();
+    for (unsigned int i = 0; i < input_count; ++i) {
+        const auto &link = link_sensors[i];
+        unsigned int value = 1000; // Null sources intentionally represent constants.
+        if (link->sensor && !link->sensor->read_temperature_checked(value)) return false;
+        if (value > INT_MAX) return false;
+        readings.push_back(value);
+    }
+    double result;
+    std::vector<double> averages;
+    if (linear) {
+        result = readings[0] * multiplier + offset;
+    } else {
+        double sum = 0;
+        for (unsigned int i = 0; i < link_sensors.size(); ++i) {
+            const auto &link = link_sensors[i];
+            const int temp = link->power_sensor ? readings[i] : readings[i] / 1000;
+            const double prior = link->prev_avg ? link->prev_avg : temp;
+            const double avg = link->offset * temp + (1.0-link->offset) * prior;
+            averages.push_back(avg);
+            sum += link->coeff * avg;
+        }
+        result = std::round(sum) * 1000;
+    }
+    if (!std::isfinite(result) || result > INT_MAX) return false;
+    const int clamped = result < 0 ? 0 : static_cast<int>(result);
+    for (unsigned int i = 0; i < averages.size(); ++i) link_sensors[i]->prev_avg = averages[i];
+    last_temp.store(clamped);
+    last_temp_valid = true;
+    out = static_cast<unsigned int>(clamped);
+    return true;
+}
