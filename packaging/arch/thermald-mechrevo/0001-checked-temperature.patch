+bool cthd_sensor_virtual::dependency_reaches(cthd_sensor *start, cthd_sensor *target, std::vector<cthd_sensor *> &seen) {
+    if (!start) return false;
+    if (start == target) return true;
+    if (std::find(seen.begin(), seen.end(), start) != seen.end()) return false;
+    seen.push_back(start);
+    auto *derived = dynamic_cast<cthd_sensor_virtual *>(start);
+    if (!derived) return false;
+    std::vector<cthd_sensor *> inputs;
+    {
+        std::lock_guard<std::mutex> guard(derived->sample_mutex);
+        if (!derived->link_sensors.empty() && derived->link_sensors[0]->sensor
+                && !derived->link_sensors[0]->coeff && !derived->link_sensors[0]->offset) {
+            inputs.push_back(derived->link_sensors[0]->sensor);
+        } else {
+            for (const auto &link : derived->link_sensors) inputs.push_back(link->sensor);
+        }
+    }
+    for (cthd_sensor *input : inputs)
+        if (dependency_reaches(input, target, seen)) return true;
+    return false;
+}
