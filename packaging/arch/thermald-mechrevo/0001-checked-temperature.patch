+int cthd_sensor_virtual::sensor_update_param(const std::string& name, double slope, double intercept) {
+    std::lock_guard<std::mutex> graph_guard(dependency_mutex);
+    cthd_sensor *sensor = thd_engine->search_sensor(name);
+    if (!sensor) return THD_ERROR;
+    std::vector<cthd_sensor *> seen;
+    if (dependency_reaches(sensor, this, seen)) return THD_ERROR;
+    std::lock_guard<std::mutex> guard(sample_mutex);
+    std::unique_ptr<link_sensor_t> link(new link_sensor_t());
+    link->sensor = sensor;
+    link->offset = 0;
+    link->coeff = 0;
