# shellcheck shell=bash
# makepkg consumes these metadata variables and supplies srcdir/pkgdir.
# shellcheck disable=SC2034,SC2154
# Maintainer: LIghtJUNction <lightjunction.me@gmail.com>
# Local package: the Rust console is independent of DKMS and the legacy tools.

pkgname=mechrevo-console
pkgver=0.1.0.r166.ge3b7852
pkgrel=1
pkgdesc='Native MECHREVO system and OEM device control console'
arch=('x86_64')
url='https://github.com/LIghtJUNction/mechrevo-drivers'
license=('GPL-2.0-or-later' 'OFL-1.1')
depends=('glibc' 'gcc-libs' 'fontconfig' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd' 'polkit')
# Cargo enforces the GUI's Rust 1.95 minimum; rustup also provides `rust`.
makedepends=('git' 'rust' 'pkgconf' 'desktop-file-utils' 'libxml2')
optdepends=('noto-fonts-cjk: Chinese system font fallback'
            'mechrevo-power-control>=0.1.0-18: qualified CPU PL1 policy control')
options=('!strip' '!debug' '!lto')

# Always build the reviewed commit, including when using an existing local repo.
_source_commit=e3b785274eb4923eff311bb9c11f6074601411d6
_source_url=${MECHREVO_CONSOLE_SOURCE:-"${url}.git"}
source=("mechrevo-drivers::git+${_source_url}#commit=${_source_commit}"
        'best.lmm.mechrevo-console.desktop')
sha256sums=('SKIP'
            '0cb013d59b97f15e9efd1937180159d69f5070b84cfced6f17ad98ad539a8d48')

_validate_source_tree() {
    cd "${srcdir}/mechrevo-drivers" || return 1
    # fakeroot changes observed stat ownership without changing source bytes.
    # Compare content to HEAD, while also rejecting staged-only modifications.
    if [[ $(git rev-parse HEAD) != "$_source_commit" ]] ||
        ! git --no-optional-locks diff --quiet HEAD -- ||
        ! git --no-optional-locks diff --cached --quiet HEAD --; then
        printf '%s\n' 'Source must be an unchanged checkout of the pinned console commit.' >&2
        return 1
    fi
    local file
    for file in console/Cargo.toml console/Cargo.lock \
        console/crates/cli/Cargo.toml console/crates/cli/src/main.rs \
        console/crates/cli/src/oem_helper.rs console/crates/cli/src/fan_helper.rs \
        console/crates/core/src/privilege.rs console/crates/core/src/fan_curve.rs \
        console/crates/core/src/cpu_power.rs \
        console/crates/core/src/fan_curve/linux.rs \
        console/crates/core/src/fan_curve/broker.rs console/crates/core/src/fan_curve/client.rs \
        console/crates/gui/src/main.rs \
        console/resources/org.mechrevo.console.oem.policy \
        console/resources/org.mechrevo.console.fan.policy \
        console/resources/org.mechrevo.console.cpu-power.policy \
        scripts/mechrevo_power.py scripts/mechrevo-power-console-helper \
        console/crates/gui/assets/fonts/Cormorant-OFL.txt \
        console/crates/gui/assets/fonts/Manrope-OFL.txt \
        docs/MECHREVO-CONSOLE-USER-GUIDE.md LICENSE; do
        if [[ ! -f $file || -L $file ]] ||
            ! git ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
            printf 'Required tracked regular source file missing: %s\n' "$file" >&2
            return 1
        fi
    done
}

prepare() {
    _validate_source_tree
}

build() {
    cd "${srcdir}/mechrevo-drivers" || return 1
    cargo build --manifest-path console/Cargo.toml \
        --target-dir "${CARGO_TARGET_DIR:-${srcdir}/cargo-target}" \
        --release --workspace --all-features --locked --offline
}

_validate_policy() {
    local role=$1
    local policy="${srcdir}/mechrevo-drivers/console/resources/org.mechrevo.console.${role}.policy"
    local annotations=1 extra=''
    if [[ $role == fan ]]; then
        annotations=2
        extra=" and count(/policyconfig/action/annotate[@key='org.freedesktop.policykit.exec.argv1'])=1 and /policyconfig/action/annotate[@key='org.freedesktop.policykit.exec.argv1']='--serve'"
    fi
    xmllint --nonet --noout "$policy" || return 1
    local xpath="boolean(count(/policyconfig)=1 and count(/policyconfig/action)=1 and count(/policyconfig/action/@*)=1 and /policyconfig/action/@id='org.mechrevo.console.${role}' and count(/policyconfig/action/annotate)=${annotations} and count(/policyconfig/action/annotate[@key='org.freedesktop.policykit.exec.path'])=1 and /policyconfig/action/annotate[@key='org.freedesktop.policykit.exec.path']='/usr/lib/mechrevo-console/${role}-helper' and count(/policyconfig/action/defaults)=1 and count(/policyconfig/action/defaults/*)=3 and count(/policyconfig/action/defaults/allow_any)=1 and /policyconfig/action/defaults/allow_any='no' and count(/policyconfig/action/defaults/allow_inactive)=1 and /policyconfig/action/defaults/allow_inactive='auth_admin' and count(/policyconfig/action/defaults/allow_active)=1 and /policyconfig/action/defaults/allow_active='auth_admin_keep'${extra})"
    if [[ $(xmllint --nonet --xpath "$xpath" "$policy") != true ]]; then
        printf '%s policy action, helper path or authorization defaults do not match the package contract.\n' "$role" >&2
        return 1
    fi
}

check() {
    _validate_source_tree || return 1
    desktop-file-validate "${srcdir}/best.lmm.mechrevo-console.desktop" || return 1
    _validate_policy oem || return 1
    _validate_policy fan
}

package() {
    check || return 1
    local binary candidate
    for binary in mechrevo-console mechrevo-console-gui \
        mechrevo-console-oem-helper mechrevo-console-fan-helper; do
        candidate="${CARGO_TARGET_DIR:-${srcdir}/cargo-target}/release/${binary}"
        if [[ ! -f $candidate || -L $candidate || ! -x $candidate ]]; then
            printf 'Required regular executable missing: %s\n' "$candidate" >&2
            return 1
        fi
    done
    for binary in mechrevo-console mechrevo-console-gui; do
        candidate="${CARGO_TARGET_DIR:-${srcdir}/cargo-target}/release/${binary}"
        install -Dm755 "$candidate" "${pkgdir}/usr/bin/${binary}" || return 1
    done
    local role helper policy installed_policy
    for role in oem fan; do
        candidate="${CARGO_TARGET_DIR:-${srcdir}/cargo-target}/release/mechrevo-console-${role}-helper"
        helper="${pkgdir}/usr/lib/mechrevo-console/${role}-helper"
        policy="console/resources/org.mechrevo.console.${role}.policy"
        installed_policy="${pkgdir}/usr/share/polkit-1/actions/org.mechrevo.console.${role}.policy"
        install -Dm755 "$candidate" "$helper" || return 1
        install -Dm644 "$policy" "$installed_policy" || return 1
        if [[ ! -f $helper || -L $helper || ! -f $installed_policy || -L $installed_policy ]] ||
            ! cmp -s "$candidate" "$helper" || ! cmp -s "$policy" "$installed_policy" ||
            [[ $(stat -c '%a' "$helper") != 755 || $(stat -c '%a' "$installed_policy") != 644 ]]; then
            printf 'Installed %s helper or policy bytes/modes do not match the package contract.\n' "$role" >&2
            return 1
        fi
    done
    install -Dm644 "${srcdir}/best.lmm.mechrevo-console.desktop" \
        "${pkgdir}/usr/share/applications/best.lmm.mechrevo-console.desktop" || return 1
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" || return 1
    install -Dm644 console/crates/gui/assets/fonts/Cormorant-OFL.txt \
        "${pkgdir}/usr/share/licenses/${pkgname}/Cormorant-OFL.txt" || return 1
    install -Dm644 console/crates/gui/assets/fonts/Manrope-OFL.txt \
        "${pkgdir}/usr/share/licenses/${pkgname}/Manrope-OFL.txt" || return 1
    install -Dm644 docs/MECHREVO-CONSOLE-USER-GUIDE.md \
        "${pkgdir}/usr/share/doc/${pkgname}/MECHREVO-CONSOLE.md" || return 1
}
